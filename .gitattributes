* text=auto eol=lf

# cmd.exe misparses batch files with LF endings; PowerShell scripts follow suit.
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore
