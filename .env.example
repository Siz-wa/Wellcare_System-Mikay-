APP_NAME=Laravel
# Production release: `composer deploy` (no-dev install, migrate, build, then
# `php artisan optimize` to cache config/routes/views/events, and worker
# restarts). Enable OPcache in php.ini on the server: opcache.enable=1,
# opcache.validate_timestamps=0 (reset with a PHP-FPM reload on each deploy).
# production: APP_ENV=production, APP_DEBUG=false. This app renders medical
# records; a debug stack trace on a live error exposes queries and payloads to
# whoever triggered it. configureProductionSafety() forces debug off when
# APP_ENV=production, but do not rely on the net.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# production: info — `debug` can write request payloads to disk.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ── Sessions ──────────────────────────────────────────────────────────────────
# The values below are the LOCAL development defaults. In production every one
# of the two marked (*) must be flipped, because `sessions.payload` and the
# session cookie both ride alongside patient records.
#
# AppServiceProvider::configureProductionSafety() forces the secure values when
# APP_ENV=production, so a mis-copied .env cannot silently ship an insecure
# session — but set them here too rather than relying on that safety net.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# (*) production: true
SESSION_ENCRYPT=false
# (*) production: true — sends the session cookie over HTTPS only.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
# `lax`, not `strict`: a verification or password-reset link opened from an
# email is a cross-site navigation, and `strict` withholds the cookie on it —
# the person arrives logged out with no way to tell why.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes every message to storage/logs and delivers nothing — fine for a
# fresh checkout, wrong for a demo. Use `failover` (config/mail.php chains it as
# smtp -> log) once the SMTP values below are filled in: Fortify's VerifyEmail
# is sent inside the registration request, so an SMTP server that refuses to
# authenticate would otherwise 500 the sign-up form.
MAIL_MAILER=log

# MAIL_SCHEME, not MAIL_ENCRYPTION — Laravel 11 dropped the latter and
# config/mail.php does not read it. Port 465 needs `smtps`; port 587 needs
# `tls`. Getting this wrong hangs the connection with no useful message.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
# For Gmail this is a 16-character App Password from
# myaccount.google.com/apppasswords (the account needs 2FA on), never the
# account's own password.
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Verify delivery end to end with:
#   php artisan wellcare:mail:test you@example.com
# It addresses the smtp leg directly, so a broken credential cannot hide behind
# the failover chain. Mail is queued, so a worker must be running for anything
# the app itself sends — `composer dev` starts one.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Reverb — WebSocket server for consultation signalling (Phase 3) ───────────
# Needs its own process: `composer dev` starts `php artisan reverb:start` as a
# fourth process. Without it every signal endpoint 500s, which is the intended
# loud failure rather than a call that silently never connects.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# What BROWSERS dial. Behind a tunnel or proxy this is the public host, 443,
# https (see TWO-DEVICE-TESTING.md).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Record access policy (QA gap G-8). false = any doctor may open any chart and
# every open is logged for the DPO; true = doctors see only their own patients.
RECORDS_CARE_TEAM_ONLY=false

# What THIS SERVER posts events to. Reverb runs beside the app, so loopback.
# Keep these on loopback even when REVERB_HOST is a tunnel: when the tunnel
# rotates, server-side broadcasts would otherwise fail with "Could not resolve
# host". Change only if Reverb runs on a different machine.
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http

# Reverb's 10,000-byte default covers the whole publish request, and Pusher
# re-escapes the SDP into a JSON string on the way in. Measured: 7,500 bytes of
# SDP relays, 8,000 returns `Pusher error: Payload too large.` A Chrome offer
# sits on that boundary and grows with each codec, ICE candidate and track, so
# the default makes video consultation fail intermittently. Not optional.
REVERB_MAX_REQUEST_SIZE=131072
REVERB_APP_MAX_MESSAGE_SIZE=131072

# ── WebRTC ICE servers (Phase 3) ──────────────────────────────────────────────
# STUN alone traversed both NATs in the 2026-08-03 two-device test, so TURN is
# left empty by default. Filling the three TURN values is all that is needed to
# add a relay for peers behind symmetric NAT — no code change, no rebuild.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ── Booking (Phase 10) ────────────────────────────────────────────────────────
# In production a patient may only check in on the day of their visit: the act
# tells the clinic someone is in the waiting room and notifies their doctor.
# Left false so a tester can walk a seeded appointment through checked_in →
# in_progress → completed without first moving its date. Set to true before the
# system is used with real patients.
BOOKING_ENFORCE_CHECKIN_DAY=false

# ── Video consultation payments ───────────────────────────────────────────────
# The clinic's OWN accounts. Nothing here is a payment gateway credential and
# no API is called with them: the patient sends money through their own GCash,
# Maya or banking app — or pays the Dasmarinas cashier — and a staff member
# confirms it arrived against the clinic's statement. The application records
# the claim and the finding, which is why it can collect for a video
# consultation without integrating a processor.
#
# A channel left blank is hidden from the patient rather than shown as an empty
# row to send money to. Cash at the cashier is always offered; it needs no
# account number.
PAYMENT_GCASH_NAME=
PAYMENT_GCASH_NUMBER=
PAYMENT_MAYA_NAME=
PAYMENT_MAYA_NUMBER=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=

# Hours before the visit that the fee must be settled, and what happens if it
# is not. Three hours matches what Philippine teleconsult services give before
# auto-cancelling an unpaid request. Set PAYMENT_AUTO_CANCEL=false to have
# wellcare:payments:sweep report what it would release and change nothing —
# the safe setting for a demo.
PAYMENT_DEADLINE_HOURS=3
PAYMENT_AUTO_CANCEL=true
# Used only when a service has no virtual price set at /admin/services.
PAYMENT_DEFAULT_FEE=500

# ── Offline demo ─────────────────────────────────────────────────────────────
# Set by `wellcare.cmd offline` / `wellcare.cmd online`, not by hand. true swaps
# internet-only content (the Google Maps embed) for a local stand-in.
OFFLINE_DEMO=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
